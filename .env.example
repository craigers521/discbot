# botalert configuration (data-model.md §5). Copy to .env and fill in.
# Every variable is documented here; the five REQUIRED ones fail fast at
# startup if missing or empty (no silent defaults for secrets or ids).

# --- Required ---
# Bot token from the Discord Developer Portal (Bot tab → Reset Token)
DISCORD_TOKEN=
# Your own Discord user id (Developer Mode → copy user id)
OWNER_DISCORD_ID=
# Discord channel id of the management channel (Developer Mode → copy channel id)
DISCORD_MANAGE_CHANNEL_ID=
# Restock webhook URL (management channel → Integrations → New Webhook)
BOTALERT_WEBHOOK_URL=
# Shared secret for the dashboard/management API (long random string)
BOTALERT_TOKEN=

# --- Optional ---
# Exposed port for the dashboard + management API
PORT=8080
# Dashboard URL shown by the "➕ Add product → dashboard" Discord button
# (button is rendered only when this is set)
BOTALERT_BASE_URL=
# Durable state file path (container default: /data/state.json)
STATE_FILE=state.json
# Per-fetch timeout in seconds (very large/slow pages)
CHECK_TIMEOUT_SECONDS=15
# Pause in seconds between consecutive page fetches (politeness)
CHECK_PAUSE_SECONDS=2
# Consecutive-failure notice threshold (once-only owner notice)
FAILURE_THRESHOLD=10
# Initial recheck cadence in minutes (first start)
DEFAULT_CADENCE_MINUTES=5
# Enforced minimum recheck cadence in minutes
MIN_CADENCE_MINUTES=1
# Enforced maximum recheck cadence in minutes (24 h)
MAX_CADENCE_MINUTES=1440
# User-Agent sent with page fetches
USER_AGENT=botalert/0.1 (personal stock checker)
